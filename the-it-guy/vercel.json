{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/agent-bundle-budget.mjs && node scripts/operational-script-deployment-audit.mjs && node scripts/agent-schema-compatibility-contract.test.mjs",
  "regions": [
    "cpt1"
  ],
  "functions": {
    "api/property24/leads/sync.js": {
      "maxDuration": 300
    },
    "api/cron/document-request-canonical-automation.js": {
      "includeFiles": "{the-it-guy/scripts/document-request-canonical-phase14-portal-verification.mjs,the-it-guy/scripts/document-request-canonical-phase15-operational-rollout.mjs,the-it-guy/scripts/document-request-canonical-phase16-automation.mjs,the-it-guy/src/**}",
      "maxDuration": 300
    },
    "api/cron/external-websites.js": {
      "maxDuration": 300
    },
    "api/cron/listing-publication.js": {
      "maxDuration": 300
    },
    "api/listings/publication-jobs.js": {
      "maxDuration": 300
    }
  },
  "env": {
    "VITE_DOCUMENT_TITLE": "Arch9 | Platform",
    "VITE_MVP_PILOT_CREATION_PAUSED": "false"
  },
  "crons": [
    {
      "path": "/api/cron/document-persistence-monitor",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/document-request-canonical-automation",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/property24/leads/sync",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/property24/statistics/sync",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/private-property-event-reconciliation",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/private-property-statistics",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/external-websites",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/listing-publication",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/join",
      "destination": "https://admin.arch9.co.za/join",
      "permanent": false
    },
    {
      "source": "/join/",
      "destination": "https://admin.arch9.co.za/join",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/|brand/|favicon(?:-[^/]+)?\\.(?:png|svg|ico)|arch9-launch-preview\\.png|vite\\.svg).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/release-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/development/:slug",
      "destination": "/api/public/development-page?slug=:slug"
    },
    {
      "source": "/share/card/:cardSlug",
      "destination": "/api/public/agent-card-share?slug=:cardSlug"
    },
    {
      "source": "/((?!api/|assets/|brand/|favicon(?:-[^/]+)?\\.(?:png|svg|ico)|apple-touch-icon\\.png|icon-(?:192|512|maskable-512)\\.png|manifest\\.webmanifest|push-sw\\.js|arch9-launch-preview\\.png|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
