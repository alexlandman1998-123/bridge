{
  "buildCommand": "npm run build",
  "env": {
    "VITE_DOCUMENT_TITLE": "Arch9 | Platform",
    "VITE_MVP_PILOT_CREATION_PAUSED": "true",
    "VITE_LEGAL_DOCUMENT_RUNTIME_ENABLED": "false",
    "VITE_LEGAL_DOCUMENT_BACKGROUND_GENERATION_ENABLED": "false",
    "VITE_LEGAL_DOCUMENT_SERVER_PDF_GENERATION_JOB_ENABLED": "false",
    "VITE_LEGAL_DOCUMENT_BROWSER_BACKGROUND_GENERATION_ENABLED": "false"
  },
  "crons": [
    {
      "path": "/api/property24/leads/sync",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/join",
      "destination": "https://admin.arch9.co.za/join",
      "permanent": false
    },
    {
      "source": "/join/",
      "destination": "https://admin.arch9.co.za/join",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/((?!api/|assets/|brand/|favicon(?:-[^/]+)?\\.(?:png|svg|ico)|arch9-launch-preview\\.png|vite\\.svg).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/release-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|brand/|favicon(?:-[^/]+)?\\.(?:png|svg|ico)|arch9-launch-preview\\.png|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
