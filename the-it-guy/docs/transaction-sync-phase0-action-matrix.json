      "audiences": ["buyer", "agent", "bond_originator", "transfer_attorney", "bond_attorney"],
      "defaultVisibility": "professional_shared",
      "visibilityRule": "Document status may be projected to clients; document contents require explicit document-level access.",
      "idempotencyScope": "transaction_id:document_id:document_version",
      "currentState": "partial"
    },
    {
      "actionKey": "BUYER_OTP_SIGNED",
      "ownerRole": "buyer",
