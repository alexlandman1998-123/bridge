{
  "schemaVersion": 1,
  "phase": "phase_0_operating_contract",
  "status": "frozen",
  "scope": "Post-transaction synchronization across buyer, seller, agent, bond-originator, attorney, and system workspaces.",
  "canonicalAuthority": {
    "aggregate": "transactions",
    "eventLog": "transaction_events",
    "laneState": "transaction_subprocesses and transaction_subprocess_steps",
    "macroRollup": "transaction_rollups and transactionJourneySnapshot",
    "sharedProgress": "transaction_shared_progress",
    "rule": "A role workspace may own a specialist record, but it may not independently define the shared transaction milestone, current workflow item, or activity history."
  },
  "roles": [
    "buyer",
    "seller",
    "agent",
    "bond_originator",
    "transfer_attorney",
    "bond_attorney",
    "cancellation_attorney",
    "system"
  ],
  "lanes": [
    "transaction_participants",
    "sales_otp",
    "finance",
    "transfer",
    "bond_registration",
    "seller_bond_cancellation",
    "registration"
  ],
  "visibility": {
    "internal": "Visible only to the owning organisation or professional team with explicit transaction permission.",
    "professional_shared": "Visible to authorised transaction professionals, but not buyer or seller portals.",
    "client_visible": "Visible only through an audience-safe projection and optionally restricted to buyer, seller, or both."
  },
  "requiredOutputs": [
    "transaction_event",
    "lane_state",
    "transaction_rollup",
    "activity_projection",
    "refresh_signal",
    "audit_record"
  ],
  "refreshContract": {
    "signal": "transaction_version_changed",
    "scope": "transaction_id",
    "targetLatencyMs": 2000,
    "pollingFallbackMs": 30000,
    "rule": "The refresh signal is emitted only after the source mutation, event append, lane calculation, rollup calculation, and activity projection commit successfully."
  },
  "profileOwnership": {
    "accountIdentity": {
      "sourceTable": "profiles",
      "fields": ["display_name", "profile_photo", "current_contact_details"],
      "rule": "Reusable account identity is resolved live and must not overwrite historical legal or signing evidence."
    },
    "transactionParticipant": {
      "sourceTable": "transaction_participants",
      "fields": ["transaction_role", "participant_status", "transaction_contact_details", "legal_capacity", "visibility_permissions"],
      "rule": "Any detail used to operate or notify a specific transaction changes through a transaction command and produces the required outputs."
    },
    "immutableEvidence": {
      "sourceTable": "documents",
      "fields": ["signed_party_name", "signed_party_capacity", "signed_contact_snapshot"],
      "rule": "Accepted or signed evidence is historical and is never silently rewritten by a later profile edit."
    }
  },
  "actions": [
    {
      "actionKey": "BUYER_TRANSACTION_PROFILE_UPDATED",
      "ownerRole": "buyer",
      "sourceTable": "transaction_participants",
      "eventType": "BuyerTransactionProfileUpdated",
      "affectedLane": "transaction_participants",
      "audiences": ["buyer", "agent", "bond_originator", "transfer_attorney", "bond_attorney", "cancellation_attorney"],
      "defaultVisibility": "professional_shared",
      "visibilityRule": "Only transaction-safe contact and participant facts are shared; legal evidence snapshots remain immutable.",
      "idempotencyScope": "transaction_id:participant_id:profile_revision",
      "currentState": "partial"
    },
    {
      "actionKey": "BUYER_ONBOARDING_COMPLETED",
      "ownerRole": "buyer",
      "sourceTable": "transaction_onboarding",
      "eventType": "BuyerOnboardingCompleted",
      "affectedLane": "sales_otp",
      "audiences": ["buyer", "seller", "agent", "bond_originator", "transfer_attorney"],
      "defaultVisibility": "client_visible",
      "clientSafeProjectionRequired": true,
      "visibilityRule": "Completion may be shared; answers and protected personal information remain permission-scoped.",
      "idempotencyScope": "transaction_id:buyer_participant_id:onboarding_revision",
      "currentState": "partial"
    },
    {
      "actionKey": "BUYER_DOCUMENT_UPLOADED",
