  "invariants": [
    "Every in-scope action has exactly one owning role and one authoritative source table.",
    "Every successful action appends one idempotent canonical transaction event.",
    "Child lane and step state is authoritative; the parent transaction rollup is derived.",
    "A specialist tracker may enrich but may not independently advance the macro transaction journey.",
    "Activity is a projection of canonical events and is never a separate source of workflow truth.",
    "Client-visible content requires audience-safe copy and explicit recipient scope.",
    "Internal content cannot be exposed by a fallback or by missing visibility metadata.",
    "A refresh signal is emitted only after all durable projections succeed.",
    "Retries are idempotent and cannot duplicate an event, activity item, notification, or milestone transition.",
    "Historical signed evidence is never silently rewritten by a later account-profile change."
  ],
  "phase1EntryCriteria": [
    "The action matrix validator passes.",
    "Product and engineering accept the authority, profile ownership, visibility, and refresh boundaries.",
    "Every currentState=disconnected action is included in the Phase 1 remediation inventory.",
    "Every currentState=partial action has an identified adapter or command path for a later implementation phase.",
    "No Phase 1 backfill or repair is allowed to rewrite signed evidence or expose internal content."
  ]
}
