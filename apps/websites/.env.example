# Server-only credentials. Never expose SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# A long random server-only secret used to HMAC visitor addresses for abuse controls.
# Raw IP addresses are never persisted.
WEBSITES_LEAD_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters

# CRM origin used by internal lead-notification links.
ARCH9_APP_URL=https://app.arch9.co.za

# Required outside demo mode. Production requires an active production-release
# record for the exact custom hostname; staging requires an active pilot record.
WEBSITES_RUNTIME_ENV=staging

# Set true only for local/demo review before a website site record exists.
WEBSITES_DEMO_MODE=true

# Comma-separated hostnames which may resolve to the neutral demo site in demo mode.
WEBSITES_DEMO_HOSTS=localhost,127.0.0.1
